# Internal service endpoints designed by this submission.
CRM_API_URL=https://internal.example/crm/customer-by-email
ERP_API_URL=https://internal.example/erp/stock
PRICING_API_URL=https://internal.example/pricing/quote
SHIPPING_API_URL=https://internal.example/shipping/rate
DRAFT_API_URL=https://internal.example/email/drafts
NOTE_API_URL=https://internal.example/crm/notes
INTERNAL_API_TOKEN=
TOOL_TIMEOUT_SECONDS=10

# Configure both values to enable OpenRouter structured extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Quote-to-Fulfillment
MAX_EXTRACTION_CHARS=30000

# Durable local protection for non-idempotent write tools.
IDEMPOTENCY_DB_PATH=.data/idempotency.sqlite3
